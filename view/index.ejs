<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ventura Indonesia | Ekosistem Digital UMKM Nasional</title>
    <link rel="icon" type="image/png" href="/logo.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: { ventura: { black: '#111111', dark: '#1a1a1a', gray: '#f9fafb' } }
                }
            }
        }
    </script>
    <style> html { scroll-behavior: smooth; } </style>
</head>
<body class="font-sans text-gray-800 bg-white antialiased">

    <!-- Navbar -->
    <nav class="fixed w-full bg-white/90 backdrop-blur-md z-50 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex-shrink-0 flex items-center gap-3">
                    <img class="h-10 w-auto" src="/logo.png" alt="Ventura Indonesia Logo">
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="#beranda" class="text-sm font-medium text-gray-900 hover:text-gray-600 transition"><%- t('nav_home') %></a>
                    <a href="#tentang" class="text-sm font-medium text-gray-900 hover:text-gray-600 transition"><%- t('nav_about') %></a>
                    <a href="#layanan" class="text-sm font-medium text-gray-900 hover:text-gray-600 transition"><%- t('nav_services') %></a>
                    <a href="#visi-misi" class="text-sm font-medium text-gray-900 hover:text-gray-600 transition"><%- t('nav_vision') %></a>
                </div>
                <div class="hidden md:flex items-center gap-4">
                    <!-- Tombol Toggle Bahasa via Query Params -->
                    <a href="?lang=<%= lang === 'id' ? 'en' : 'id' %>" class="text-sm font-bold text-ventura-black bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-md transition inline-flex items-center justify-center">
                        <%= lang === 'id' ? 'EN' : 'ID' %>
                    </a>
                    <a href="#kontak" class="bg-ventura-black text-white px-5 py-2.5 rounded-full text-sm font-medium hover:bg-gray-800 transition shadow-lg shadow-gray-200">
                        <%- t('nav_consult') %>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="beranda" class="pt-32 pb-20 lg:pt-48 lg:pb-32 bg-ventura-gray overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
            <div class="text-center max-w-4xl mx-auto">
                <span class="inline-block py-1 px-3 rounded-full bg-gray-200 text-sm font-semibold text-ventura-black mb-6 tracking-wide uppercase">
                    <%- t('hero_tag') %>
                </span>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ventura-black leading-tight tracking-tight mb-6">
                    <%- t('hero_title') %>
                </h1>
                <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-3xl mx-auto leading-relaxed">
                    <%- t('hero_desc') %>
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="#layanan" class="bg-ventura-black text-white px-8 py-3.5 rounded-full text-base font-medium hover:bg-gray-800 transition shadow-lg">
                        <%- t('hero_btn1') %>
                    </a>
                    <a href="#kontak" class="bg-white text-ventura-black border border-gray-300 px-8 py-3.5 rounded-full text-base font-medium hover:bg-gray-50 transition">
                        <%- t('hero_btn2') %>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="tentang" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold text-ventura-black mb-6"><%- t('about_title') %></h2>
                    <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
                        <p><%- t('about_p1') %></p>
                        <p><%- t('about_p2') %></p>
                    </div>
                </div>
                <div class="bg-gray-100 rounded-2xl h-96 w-full flex items-center justify-center relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-tr from-gray-200 to-gray-100"></div>
                    <svg class="w-24 h-24 text-gray-300 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m3-4h1m-1 4h1m-5 8h8"></path></svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Pillars Section -->
    <section id="layanan" class="py-20 bg-ventura-gray">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-ventura-black mb-4"><%- t('service_title') %></h2>
                <p class="text-lg text-gray-600"><%- t('service_desc') %></p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Pilar 1 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
                    <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center mb-6 text-ventura-black">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-ventura-black mb-3"><%- t('service_1_title') %></h3>
                    <p class="text-gray-600 leading-relaxed text-sm md:text-base"><%- t('service_1_desc') %></p>
                </div>

                <!-- Pilar 2 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
                    <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center mb-6 text-ventura-black">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-ventura-black mb-3"><%- t('service_2_title') %></h3>
                    <p class="text-gray-600 leading-relaxed text-sm md:text-base"><%- t('service_2_desc') %></p>
                </div>

                <!-- Pilar 3 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition">
                    <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center mb-6 text-ventura-black">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-ventura-black mb-3"><%- t('service_3_title') %> <span class="text-gray-500 font-medium">(Webkaven)</span></h3>
                    <p class="text-gray-600 leading-relaxed text-sm md:text-base"><%- t('service_3_desc') %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Vision & Mission Section -->
    <section id="visi-misi" class="py-20 bg-white border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                <!-- Visi -->
                <div class="p-8 bg-ventura-black text-white rounded-2xl shadow-lg">
                    <h3 class="text-2xl font-bold mb-6 flex items-center gap-3">
                        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        <span><%- t('vision_title') %></span>
                    </h3>
                    <p class="text-lg leading-relaxed text-gray-300"><%- t('vision_desc') %></p>
                </div>
                
                <!-- Misi -->
                <div class="flex flex-col justify-center">
                    <h3 class="text-2xl font-bold text-ventura-black mb-6 flex items-center gap-3">
                        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <span><%- t('mission_title') %></span>
                    </h3>
                    <ul class="space-y-5">
                        <li class="flex items-start gap-4">
                            <div class="mt-1 bg-gray-100 p-1 rounded-full text-ventura-black"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>
                            <p class="text-gray-600"><%- t('mission_1') %></p>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="mt-1 bg-gray-100 p-1 rounded-full text-ventura-black"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>
                            <p class="text-gray-600"><%- t('mission_2') %></p>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="mt-1 bg-gray-100 p-1 rounded-full text-ventura-black"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>
                            <p class="text-gray-600"><%- t('mission_3') %></p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section id="kontak" class="py-24 bg-ventura-black text-white text-center">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-5xl font-bold mb-6"><%- t('cta_title') %></h2>
            <p class="text-xl text-gray-400 mb-10"><%- t('cta_desc') %></p>
            <a href="#" class="inline-block bg-white text-ventura-black px-10 py-4 rounded-full text-lg font-bold hover:bg-gray-100 transition shadow-xl">
                <%- t('cta_btn') %>
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-ventura-dark text-gray-400 py-8 border-t border-gray-800 text-center text-sm">
        <div class="max-w-7xl mx-auto px-4">
            <p><%- t('footer_text') %></p>
        </div>
    </footer>
</body>
</html>